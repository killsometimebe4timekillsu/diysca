# PostgreSQL for diysca (Podman Quadlet). Put the password in /etc/diysca/db.env:
#   POSTGRES_PASSWORD=...   and   DIYSCA_DATABASE_URL=postgresql://diysca:...@diysca-db:5432/diysca
[Unit]
Description=diysca PostgreSQL

[Container]
Image=docker.io/library/postgres:17
ContainerName=diysca-db
Network=diysca.network
Environment=POSTGRES_USER=diysca POSTGRES_DB=diysca
EnvironmentFile=/etc/diysca/db.env
Volume=diysca-db:/var/lib/postgresql/data
HealthCmd=pg_isready -U diysca
AutoUpdate=registry

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target default.target
