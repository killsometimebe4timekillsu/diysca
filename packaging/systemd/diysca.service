[Unit]
Description=diysca - DIY CVE scanner (web UI + scheduler)
Documentation=https://github.com/killsometimebe4timekillsu/diysca
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=diysca
Group=diysca
Environment=DIYSCA_LISTEN=127.0.0.1 DIYSCA_PORT=8080
EnvironmentFile=-/etc/default/diysca
Environment=DIYSCA_CONFIG=/etc/diysca/config.yml
ExecStart=/usr/bin/diysca serve --host ${DIYSCA_LISTEN} --port ${DIYSCA_PORT}
StateDirectory=diysca
StateDirectoryMode=0750
WorkingDirectory=/var/lib/diysca
Restart=on-failure
RestartSec=5
# hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
